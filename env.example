# AI Lead Hunter — copy to a local .env file. Never commit secrets.
# Platform injects most of these in preview/production.

# Postgres. Leave unset to use embedded PGLite in preview.
DATABASE_URL=

# Preferred AI provider: xai | openai | anthropic | google | openrouter
AI_PROVIDER=xai
# Optional second provider if the primary fails retryably
AI_FALLBACK_PROVIDER=

# xAI (server only — never prefix with VITE_)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1/chat/completions
XAI_MODEL=grok-4.5

# OpenAI-compatible fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Lead sources (server-side). Leave blank = "Not configured".
GOOGLE_PLACES_API_KEY=
SERPER_API_KEY=
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Set false to disable the public OSM adapter
OSM_OVERPASS_ENABLED=true

# Default on for new workspaces. Set false to default new workspaces to live fetches.
ENABLE_DEMO_MODE=true

# Auth client IDs are injected by the platform. Do not put provider keys in VITE_*.
